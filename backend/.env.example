NODE_ENV=development
PORT=3000

# Zona horaria del negocio. Determina qué se considera "hoy" y qué horarios ya
# pasaron en el filtro de disponibilidad y los reportes. Si se omite, el código
# usa America/Costa_Rika.
BUSINESS_TIMEZONE=America/Costa_Rika

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=barbermanager

# Obligatorio: no hay valor por defecto seguro, la app no arranca sin esto.
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=8h

# Origin exacto del frontend. Obligatorio en producción: la sesión viaja en una
# cookie httpOnly con CORS credentials:true, que no admite origin '*'.
CORS_ORIGIN=http://localhost:5173
